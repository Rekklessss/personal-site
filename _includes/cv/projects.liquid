{% comment %}
  Unified projects entry renderer for both formats
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush">
  {% for entry in entries %}
    <li class="list-group-item">
      <div class="cv-project-heading">
        {% if entry.url %}
          <h6 class="title font-weight-bold">
            <a href="{{ entry.url }}" target="_blank" rel="noopener noreferrer">{{ entry.name }}</a>
          </h6>
        {% else %}
          <h6 class="title font-weight-bold">{{ entry.name }}</h6>
        {% endif %}
        {% if entry.github %}
          <a
            class="cv-project-source"
            href="{{ entry.github }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ entry.name }} source on GitHub"
            title="View on GitHub"
          >
            <i class="fa-brands fa-github" aria-hidden="true"></i> <span>Source</span>
          </a>
        {% endif %}
      </div>

      {% if entry.summary %}
        <p>{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
      {% endif %}

      {% if entry.highlights %}
        <ul class="items">
          {% for item in entry.highlights %}
            <li>
              <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </li>
  {% endfor %}
</ul>
